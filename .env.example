# Copy to .env (never commit it) or set these in your hosting panel.
# Generate strong keys with:  python -m lager.keygen

# --- Access -----------------------------------------------------------
# Full access (the mobile app). Required: the API refuses to serve data without it.
LAGER_API_KEY=
# Optional read-only key for Home Assistant and MCP/AI clients.
LAGER_READ_KEY=
# Comma separated browser origins allowed to call the API (only needed for
# the web build). Leave empty for native apps, Home Assistant and MCP.
LAGER_CORS_ORIGINS=

# --- Database (MySQL / MariaDB) ---------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- AI component identification --------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Max AI analyses per day (protects your API credits). 0 disables AI.
AI_DAILY_LIMIT=50

# --- Limits -------------------------------------------------------------
# MAX_BODY_BYTES=8388608
# MAX_IMAGE_BYTES=5242880

# Local development only - NEVER enable on a public server.
# LAGER_ALLOW_INSECURE_NO_AUTH=1
